# ==============================================================================
# Frontend Environment Configuration - Ecora (Vercel / Production / Development)
# ==============================================================================

# URL base del Backend en Railway (con /api al final)
# En desarrollo: http://localhost:8000/api
# En producción: https://ecora-backend.up.railway.app/api
VITE_API_BASE_URL=https://ecora-backend.up.railway.app/api

# Supabase (Auth, Storage & Realtime Chat)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_SUPABASE_ANON_KEY

# Stripe (Clave Pública para Frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_or_live_YOUR_STRIPE_PUBLISHABLE_KEY
