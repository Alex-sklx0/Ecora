# ==============================================================================
# Backend Environment Configuration - Ecora (Railway / Production / Development)
# ==============================================================================

# Entorno y Servidor
PORT=8000
NODE_ENV=production

# URLs y Orígenes Frontend (puedes separar varios orígenes con comas)
FRONTEND_URL=https://ecora-frontend.vercel.app,http://localhost:5173

# Base de datos Supabase (PostgreSQL)
# Conexión Pooler (puerto 6543) o Directa (puerto 5432)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# API de Supabase y Storage
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_SUPABASE_ANON_KEY

# Better-Auth (Autenticación y Sesiones)
BETTER_AUTH_SECRET=YOUR_RANDOM_SECRET_KEY_MIN_32_CHARACTERS
BETTER_AUTH_URL=https://ecora-backend.up.railway.app
BETTER_AUTH_TRUSTED_ORIGINS=https://ecora-frontend.vercel.app,http://localhost:5173

# Stripe (Pasarela de Pagos)
STRIPE_SECRET_KEY=sk_live_or_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET
STRIPE_CURRENCY=cop
